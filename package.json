    "@splinetool/runtime": "1.12.90",
    "@tanstack/react-query": "5.100.9",
    "@upstash/qstash": "2.11.3",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.37.0",
    "framer-motion": "12.38.0",
    "gsap": "3.15.0",
    "html2pdf.js": "0.14.0",
    "lucide-react": "1.14.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
