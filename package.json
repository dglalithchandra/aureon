    "@typescript-eslint/parser": "8.59.1",
    "@vitest/coverage-v8": "5.0.1",
    "clsx": "2.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
