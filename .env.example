# Aureon environment variables.
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# LLM provider: "gemini" (production default) or "openrouter" (free-tier dev).
# When unset, defaults to "gemini".
LLM_PROVIDER=gemini

# Google AI Studio key. Required when LLM_PROVIDER=gemini.
# Free key (no card): https://aistudio.google.com/apikey
# The free tier is rate limited per minute and per day; the client backs off
# and retries a 429 twice before failing the round.
GEMINI_API_KEY=

# Models. Optional - these are the defaults. Check which ids your key can use
# at https://aistudio.google.com/ ; changing them needs no code change.
# GEMINI_MODEL=gemini-3.8-flash            # the pipeline: extraction, questions, documents
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite  # small jobs: module names from a README
# Only for pointing the client at a proxy or a local stand-in.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# OpenRouter API key. Required when LLM_PROVIDER=openrouter.
# Free signup at https://openrouter.ai/ — no credit card needed for free models.
# Default model used: meta-llama/llama-3.3-70b-instruct:free (override via OPENROUTER_MODEL).
# Quality is noticeably lower; use for smoke tests only. Free models route to
# third-party providers whose data policies vary, so production refuses this
# provider unless ALLOW_FREE_MODELS=1 says otherwise (PRIV-01).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# ALLOW_FREE_MODELS=1

# Postgres connection string. REQUIRED in production: projects, share links
# and accounts live here. Neon (https://neon.com) gives a free database; use
# its POOLED connection string. Any Postgres works.
# After setting it, create the tables with: npm run db:migrate
DATABASE_URL=

# ── Accounts ────────────────────────────────────────────────────────────
# Auth.js signs session cookies and magic-link tokens with this. REQUIRED
# once a sign-in method below is configured. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Google sign-in. Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add the callback
#   http://localhost:3000/api/auth/callback/google   (and your deployed URL)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic-link sign-in, sent over an HTTPS email API (not SMTP: the SMTP
# client nodemailer has open high-severity advisories). Any API taking
# {from,to,subject,html,text} with a bearer token works; the default URL is
# Resend's. Free key at https://resend.com — sending to addresses outside
# your own needs a verified domain. Leave empty to offer Google only.
#   EMAIL_FROM=Aureon <onboarding@resend.dev>
EMAIL_API_KEY=
EMAIL_FROM=
# EMAIL_API_URL=https://api.resend.com/emails

# Bearer token Vercel's cron scheduler sends to /api/cron/retention (the
# daily job that deletes raw client input past its retention period).
# Without it the endpoint refuses every request. 16+ characters.
CRON_SECRET=

# GitHub personal access token (classic, public_repo scope only). Optional.
# Without this the GitHub layer falls back to anonymous (60 req/hr).
# With it: 5000 req/hr.
GITHUB_TOKEN=

# Upstash Redis (used for rate limiting + session storage). Optional in dev.
# Without these, an in-memory limiter and in-memory session store are used.
# REQUIRED when NODE_ENV=production: the server refuses to start without them,
# because serverless instances do not share memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to 1 to run production on in-memory storage anyway — only safe for a
# single long-running instance, e.g. a local `next start`.
# ALLOW_MEMORY_STORE=1

# Upstash QStash — the durable job queue for LLM work. Optional in dev.
# /run, /answer and /finalize answer 202 at once and queue a job that QStash
# delivers to POST /api/jobs/[type] (signature-checked with the two signing
# keys). Without QSTASH_TOKEN, jobs run in-process after the response
# (Next.js after()) — fine locally, but not durable. Production MUST set these.
# All four values: https://console.upstash.com/qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Only for a local QStash dev server; leave empty for the hosted service.
QSTASH_URL=
# Public base URL QStash calls back. Optional: defaults to the origin of the
# request that queued the job (right for Vercel previews). Set it if the app
# sits behind a proxy that rewrites the host.
JOBS_BASE_URL=
# Set automatically by Vercel when "Protection Bypass for Automation" is
# enabled; lets QStash reach deployments behind Deployment Protection.
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Global cap on LLM calls per UTC day across all users (cost guard). Past it,
# LLM routes answer 503 BUDGET_EXCEEDED. Optional; defaults to 2000.
LLM_DAILY_CALL_LIMIT=2000

# 32+ character secret used to HMAC-sign session ownership cookies.
# REQUIRED in production. In dev a per-process random secret is auto-generated.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: a Spline 3D scene URL for the landing hero.
# Get one from https://app.spline.design (export → public link, e.g.
#   https://prod.spline.design/abcdef/scene.splinecode).
# When unset, an animated SVG wireframe fallback is used instead.
NEXT_PUBLIC_SPLINE_SCENE=

# ── Error tracking (OBS-01) ─────────────────────────────────────────────
# Optional. Where an unexpected failure is posted as JSON: a Sentry ingest
# proxy, a Slack incoming webhook, a log drain, anything that takes a POST.
# Unset (the default) means failures are logged and nothing is sent. Only
# shapes are sent — message, error name, route, session id, request id —
# never a brief, an answer or a generated document.
ERROR_WEBHOOK_URL=
# Sent as "Authorization: Bearer ..." with the report, when the endpoint
# wants one.
ERROR_WEBHOOK_TOKEN=

# Public app URL (used by share links and absolute redirects). Optional in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
