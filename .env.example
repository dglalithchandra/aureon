# Aureon environment variables.
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# LLM provider: "anthropic" (production default) or "openrouter" (free-tier dev).
# When unset, defaults to "anthropic".
LLM_PROVIDER=anthropic

# Anthropic Claude API key. Required when LLM_PROVIDER=anthropic.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenRouter API key. Required when LLM_PROVIDER=openrouter.
# Free signup at https://openrouter.ai/ — no credit card needed for free models.
# Default model used: meta-llama/llama-3.3-70b-instruct:free (override via OPENROUTER_MODEL).
# Quality is noticeably lower than Claude Sonnet 4.6; use for smoke tests only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# GitHub personal access token (classic, public_repo scope only). Optional.
# Without this the GitHub layer falls back to anonymous (60 req/hr).
# With it: 5000 req/hr.
GITHUB_TOKEN=

# Upstash Redis (used for rate limiting + session storage). Optional in dev.
# Without these, an in-memory limiter and in-memory session store are used.
# REQUIRED when NODE_ENV=production: the server refuses to start without them,
# because serverless instances do not share memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to 1 to run production on in-memory storage anyway — only safe for a
# single long-running instance, e.g. a local `next start`.
# ALLOW_MEMORY_STORE=1

# Upstash QStash — the durable job queue for LLM work. Optional in dev.
# /run, /answer and /finalize answer 202 at once and queue a job that QStash
# delivers to POST /api/jobs/[type] (signature-checked with the two signing
# keys). Without QSTASH_TOKEN, jobs run in-process after the response
# (Next.js after()) — fine locally, but not durable. Production MUST set these.
# All four values: https://console.upstash.com/qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Only for a local QStash dev server; leave empty for the hosted service.
QSTASH_URL=
# Public base URL QStash calls back. Optional: defaults to the origin of the
# request that queued the job (right for Vercel previews). Set it if the app
# sits behind a proxy that rewrites the host.
JOBS_BASE_URL=
# Set automatically by Vercel when "Protection Bypass for Automation" is
# enabled; lets QStash reach deployments behind Deployment Protection.
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Global cap on LLM calls per UTC day across all users (cost guard). Past it,
# LLM routes answer 503 BUDGET_EXCEEDED. Optional; defaults to 2000.
LLM_DAILY_CALL_LIMIT=2000

# 32+ character secret used to HMAC-sign session ownership cookies.
# REQUIRED in production. In dev a per-process random secret is auto-generated.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: a Spline 3D scene URL for the landing hero.
# Get one from https://app.spline.design (export → public link, e.g.
#   https://prod.spline.design/abcdef/scene.splinecode).
# When unset, an animated SVG wireframe fallback is used instead.
NEXT_PUBLIC_SPLINE_SCENE=

# Public app URL (used by share links and absolute redirects). Optional in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
