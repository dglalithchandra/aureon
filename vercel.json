{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/jobs/[type]/route.ts": {
      "maxDuration": 300
    },
    "app/api/finalize/route.ts": {
      "maxDuration": 300
    },
    "app/api/session/route.ts": {
      "maxDuration": 60
    },
    "app/api/session/[id]/run/route.ts": {
      "maxDuration": 300
    },
    "app/api/session/[id]/answer/route.ts": {
      "maxDuration": 300
    },
    "app/api/session/[id]/describe/route.ts": {
      "maxDuration": 300
    },
    "app/api/session/[id]/clarify/route.ts": {
      "maxDuration": 300
    },
    "app/api/session/[id]/events/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/retention/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "15 3 * * *"
    }
  ]
}
